{%- liquid
  assign handles_raw = section.settings.product_handles | strip
  if handles_raw == blank
    assign handles_raw = 'offer-burhan-box-ava,offer-4-home-2-luxury-spray,offer-4-luxury-2-spray-bodyoil,offer-3-home-spray-gift'
  endif
  assign offer_handles = handles_raw | split: ','
  assign layout = section.settings.layout | default: 'carousel'
  assign page_url = section.settings.page_link
  if page_url == blank
    if pages.offers != blank
      assign page_url = pages.offers.url
    else
      assign page_url = '/pages/offers'
    endif
  endif
-%}

<section
  class="offers-showcase section-padding offers-showcase--{{ layout }}{% if section.settings.page_mode %} offers-showcase--page{% endif %}"
  data-animate-section
  {% if section.settings.enable_countdown and section.settings.countdown_end != blank %}
    data-offers-countdown
    data-countdown-end="{{ section.settings.countdown_end }}"
  {% endif %}
>
  <div class="offers-showcase__header">
    <div class="offers-showcase__titles">
      {% if section.settings.eyebrow != blank %}
        <p class="offers-showcase__eyebrow">{% render 'tanween', text: section.settings.eyebrow %}</p>
      {% endif %}
      <h2 class="section-heading offers-showcase__heading">{% render 'tanween', text: section.settings.heading %}</h2>
      {%- if section.settings.enable_countdown and section.settings.countdown_end != blank -%}
        <div class="offers-showcase__countdown" data-countdown hidden>
          <span class="offers-showcase__countdown-label">{{ 'sections.featured_collection.countdown_label' | t }}</span>
          <div class="offers-showcase__countdown-units" data-countdown-units aria-live="polite"></div>
        </div>
      {%- endif -%}
      {% if section.settings.subheading != blank %}
        <p class="section-subheading offers-showcase__subheading">{% render 'tanween', text: section.settings.subheading %}</p>
      {% endif %}
    </div>
    {% if section.settings.show_view_all and layout == 'carousel' %}
      <a href="{{ page_url }}" class="offers-showcase__view-all">
        {{ 'sections.featured_collection.view_all' | t }}
        <span aria-hidden="true">&lsaquo;</span>
      </a>
    {% endif %}
  </div>

  {%- capture offer_cards -%}
    {%- for handle in offer_handles -%}
      {%- assign handle_clean = handle | strip -%}
      {%- assign offer_product = all_products[handle_clean] -%}
      {%- if offer_product != blank -%}
        <div class="offers-showcase__item">
          {% render 'product-card', product: offer_product %}
        </div>
      {%- endif -%}
    {%- endfor -%}
  {%- endcapture -%}

  {% if offer_cards != blank %}
    {% if layout == 'grid' %}
      <div class="offers-showcase__grid">
        {{ offer_cards }}
      </div>
    {% else %}
      <div class="offers-showcase__carousel" data-carousel>
        <button type="button" class="offers-showcase__nav offers-showcase__nav--prev" data-carousel-prev aria-label="{{ 'general.pagination.previous' | t }}">&lsaquo;</button>
        <div class="offers-showcase__track-wrap">
          <div class="offers-showcase__track" data-carousel-track>
            {{ offer_cards }}
          </div>
        </div>
        <button type="button" class="offers-showcase__nav offers-showcase__nav--next" data-carousel-next aria-label="{{ 'general.pagination.next' | t }}">&rsaquo;</button>
        <div class="offers-showcase__dots" data-carousel-dots role="tablist" aria-label="{{ 'general.pagination.label' | t }}"></div>
      </div>
    {% endif %}
  {% else %}
    <p class="offers-showcase__empty">{{ section.settings.empty_text }}</p>
  {% endif %}
</section>

{% stylesheet %}
  .offers-showcase--page {
    position: relative;
    background:
      radial-gradient(ellipse 80% 50% at 100% 0%, color-mix(in srgb, var(--color-gold) 18%, transparent), transparent 55%),
      radial-gradient(ellipse 70% 45% at 0% 100%, color-mix(in srgb, var(--color-primary) 10%, transparent), transparent 50%),
      var(--color-background, #faf6ef);
  }

  .offers-showcase__header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    max-width: var(--page-width);
    margin-inline: auto;
    margin-block-end: 1.25rem;
    padding-inline: var(--page-margin);
  }

  .offers-showcase__titles { flex: 1; min-width: 0; }

  .offers-showcase__eyebrow {
    margin: 0 0 0.35rem;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--color-gold, #c4a46c);
  }

  .offers-showcase__heading,
  .offers-showcase__subheading {
    text-align: start;
    margin-inline: 0;
  }

  .offers-showcase--page .offers-showcase__header {
    flex-direction: column;
    align-items: flex-start;
    margin-block-end: 1.75rem;
    padding-block-start: 0.5rem;
  }

  .offers-showcase--page .offers-showcase__heading {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    margin-block-end: 0.5rem;
  }

  .offers-showcase--page .offers-showcase__subheading {
    max-width: 36rem;
    font-size: 1.05rem;
    line-height: 1.8;
  }

  .offers-showcase__countdown {
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    gap: 0.5rem;
    margin-block: 0.65rem 0.35rem;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .offers-showcase__countdown::-webkit-scrollbar { display: none; }
  .offers-showcase__countdown[hidden] { display: none; }
  .offers-showcase__countdown-label {
    flex-shrink: 0;
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--color-primary);
  }
  .offers-showcase__countdown-units {
    display: flex;
    flex-wrap: nowrap;
    gap: 0.35rem;
  }
  .offers-showcase__countdown-unit {
    min-width: 2.85rem;
    padding: 0.3rem 0.4rem;
    border-radius: 0.65rem;
    background: color-mix(in srgb, var(--color-gold) 16%, var(--color-cream, #faf6ef));
    text-align: center;
    font-size: 0.7rem;
  }
  .offers-showcase__countdown-unit strong {
    display: block;
    font-size: 0.95rem;
    color: var(--color-primary);
  }

  .offers-showcase__view-all {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-weight: 700;
    color: var(--color-primary);
    text-decoration: none;
  }
  .offers-showcase__view-all:hover { color: var(--color-primary-dark); }

  .offers-showcase__carousel {
    position: relative;
    max-width: var(--page-width);
    margin-inline: auto;
    padding-inline: var(--page-margin);
  }
  .offers-showcase__track-wrap { overflow: hidden; }
  .offers-showcase__track {
    display: flex;
    gap: 1rem;
    align-items: stretch;
  }
  .offers-showcase__item {
    flex: 0 0 calc(72% - 0.5rem);
    min-width: 0;
    scroll-snap-align: start;
  }
  .offers-showcase__item .product-card { width: 100%; height: 100%; }

  .offers-showcase__grid {
    display: grid;
    gap: 1.25rem;
    max-width: var(--page-width);
    margin-inline: auto;
    padding-inline: var(--page-margin);
    grid-template-columns: 1fr;
  }
  .offers-showcase__grid .offers-showcase__item { min-width: 0; }

  .offers-showcase__empty {
    text-align: center;
    color: var(--color-accent);
    padding: 2rem var(--page-margin);
  }

  .offers-showcase__nav {
    position: absolute;
    top: 42%;
    transform: translateY(-50%);
    z-index: 2;
    width: 2.25rem;
    height: 2.25rem;
    border: 0;
    border-radius: 999px;
    background: var(--color-primary);
    color: #fff;
    font-size: 1.25rem;
    cursor: pointer;
  }
  .offers-showcase__nav:hover { background: var(--color-primary-dark); }
  .offers-showcase__nav--prev { inset-inline-start: 0; }
  .offers-showcase__nav--next { inset-inline-end: 0; }

  .offers-showcase__dots {
    display: flex;
    justify-content: center;
    gap: 0.4rem;
    margin-block-start: 1rem;
  }
  .offers-showcase__dot {
    width: 0.5rem;
    height: 0.5rem;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-dark) 22%, transparent);
    cursor: pointer;
  }
  .offers-showcase__dot.is-active {
    background: var(--color-primary);
    transform: scale(1.15);
  }

  @media (min-width: 768px) {
    .offers-showcase__carousel { padding-inline: calc(var(--page-margin) + 2rem); }
    .offers-showcase__item { flex: 0 0 calc(33.333% - 0.667rem); }
    .offers-showcase__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.5rem; }
    .offers-showcase__nav { width: 2.5rem; height: 2.5rem; font-size: 1.5rem; }
  }

  @media (min-width: 1024px) {
    .offers-showcase__item { flex: 0 0 calc(25% - 0.75rem); }
    .offers-showcase__grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }

  @media (max-width: 767px) {
    .offers-showcase__header { flex-wrap: wrap; align-items: flex-start; }
    .offers-showcase__countdown {
      flex-direction: column;
      align-items: flex-start;
      overflow: visible;
    }
    .offers-showcase__countdown-units {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      width: 100%;
    }
  }
{% endstylesheet %}

{% javascript %}
  (function () {
    const sections = document.querySelectorAll('[data-offers-countdown]');
    if (!sections.length) return;

    const labels = { d: 'ي', h: 'س', m: 'د', s: 'ث' };

    function unit(value, key) {
      return `<span class="offers-showcase__countdown-unit featured-collection__countdown-unit"><strong>${value}</strong>${labels[key]}</span>`;
    }

    sections.forEach((section) => {
      const endRaw = section.getAttribute('data-countdown-end');
      const box = section.querySelector('[data-countdown]');
      const units = section.querySelector('[data-countdown-units]');
      if (!endRaw || !box || !units) return;
      const end = new Date(endRaw).getTime();
      if (Number.isNaN(end)) return;

      function tick() {
        const diff = end - Date.now();
        if (diff <= 0) {
          box.hidden = true;
          return;
        }
        box.hidden = false;
        const d = Math.floor(diff / 86400000);
        const h = Math.floor((diff % 86400000) / 3600000);
        const m = Math.floor((diff % 3600000) / 60000);
        const s = Math.floor((diff % 60000) / 1000);
        units.innerHTML = unit(d, 'd') + unit(h, 'h') + unit(m, 'm') + unit(s, 's');
      }
      tick();
      setInterval(tick, 1000);
    });
  })();
{% endjavascript %}

{% schema %}
{
  "name": "عروضنا",
  "class": "offers-showcase-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "سطر علوي",
      "default": "أنفاس العنود"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "العنوان",
      "default": "عروضنا"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "الوصف",
      "default": "عروض محدودة وتوفير حلو — خذي فرصتج قبل ما تروح."
    },
    {
      "type": "select",
      "id": "layout",
      "label": "التخطيط",
      "default": "carousel",
      "options": [
        { "value": "carousel", "label": "كاروسيل" },
        { "value": "grid", "label": "شبكة" }
      ]
    },
    {
      "type": "checkbox",
      "id": "page_mode",
      "label": "نمط صفحة كاملة",
      "default": false
    },
    {
      "type": "text",
      "id": "product_handles",
      "label": "مقابض المنتجات (مفصولة بفاصلة)",
      "default": "offer-burhan-box-ava,offer-4-home-2-luxury-spray,offer-4-luxury-2-spray-bodyoil,offer-3-home-spray-gift",
      "info": "يُحمَّل كل منتج مباشرة بالـ handle — بدون الاعتماد على إعداد المجموعة."
    },
    {
      "type": "url",
      "id": "page_link",
      "label": "رابط عرض الكل"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "إظهار زر عرض الكل",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_countdown",
      "label": "عدّاد تنازلي",
      "default": false
    },
    {
      "type": "text",
      "id": "countdown_end",
      "label": "نهاية العدّاد",
      "placeholder": "2026-08-31T23:59"
    },
    {
      "type": "text",
      "id": "empty_text",
      "label": "نص عند الفراغ",
      "default": "العروض بتظهر هنا قريب."
    }
  ],
  "presets": [{ "name": "عروضنا" }]
}
{% endschema %}
